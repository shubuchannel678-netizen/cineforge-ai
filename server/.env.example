# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini API (Required for live Gemini 2.5 Flash / Pro orchestration)
GEMINI_API_KEY=

# Supabase Configuration (dpjkyfiehwpzxqavtdtm.supabase.co)
SUPABASE_URL=https://dpjkyfiehwpzxqavtdtm.supabase.co
SUPABASE_ANON_KEY=
